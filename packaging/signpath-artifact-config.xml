<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath Artifact Configuration for the Download Sorter app binaries ZIP.
  In release.yml, `pe_signing.py stage` collects only unsigned .exe, .dll, and .pyd
  files from dist/DownloadSorter/ (preserving relative paths and leaving already-signed
  Microsoft / Python / Qt files untouched) before uploading the artifact to SignPath.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="**/*.exe" min-matches="0" max-matches="unbounded" />
      <include path="**/*.dll" min-matches="0" max-matches="unbounded" />
      <include path="**/*.pyd" min-matches="0" max-matches="unbounded" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
