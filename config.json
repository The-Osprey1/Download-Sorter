{
  "schema_version": 2,
  "watch": {
    "folder": "${USERPROFILE}\\Downloads",
    "settle_seconds": 3.0,
    "min_age_minutes": 0,
    "auto_unpack_3d_zips": false,
    "auto_unzip": false,
    "extracted_destination": "Extracted"
  },
  "auto_unpack_3d_zips": false,
  "auto_unzip": false,
  "extracted_destination": "Extracted",
  "gcode_sniffer_enabled": true,
  "haas_destination": "3D Models",
  "gcode_destination": "3D Models",
  "document_sources": [],
  "documents_keep_extensions": [
    ".pdf",
    ".doc",
    ".docx",
    ".xls",
    ".xlsx",
    ".xlsm",
    ".csv",
    ".odt",
    ".ods",
    ".rtf"
  ],
  "documents_relocate_extensions": [
    ".stl",
    ".3mf",
    ".obj",
    ".step",
    ".stp",
    ".iges",
    ".igs",
    ".gcode",
    ".bgcode",
    ".3ds",
    ".fbx",
    ".blend",
    ".glb",
    ".gltf",
    ".f3d",
    ".f3z",
    ".ipt",
    ".iam",
    ".sldprt",
    ".sldasm",
    ".slddrw",
    ".dwg",
    ".dxf",
    ".nc",
    ".tap",
    ".ngc"
  ],
  "documents_ignore_dirs": [
    "Sorter Recovery",
    "CAD & 3D Projects",
    "Arduino",
    "KiCad",
    "MAXON",
    ".git",
    "node_modules",
    "My Games",
    "Saved Games",
    "Steam",
    "Electronic Arts",
    "EA Games",
    "Paradox Interactive",
    "Rockstar Games",
    "Adobe",
    "PowerToys",
    "SOLIDCast",
    "SOLIDCast Projects"
  ],
  "ignore_extensions": [
    ".crdownload",
    ".part",
    ".partial",
    ".tmp",
    ".download",
    ".opdownload"
  ],
  "ignore_names": [
    "desktop.ini",
    "thumbs.db"
  ],
  "keyword_rules": [],
  "extension_rules": [
    {
      "name": "Documents",
      "folder": "Documents",
      "extensions": [
        ".pdf",
        ".doc",
        ".docx",
        ".odt",
        ".rtf",
        ".txt",
        ".md",
        ".xls",
        ".xlsx",
        ".xlsm",
        ".csv",
        ".ods",
        ".ppt",
        ".pptx",
        ".odp",
        ".key",
        ".epub",
        ".mobi",
        ".tex",
        ".bib",
        ".pkpass"
      ],
      "enabled": true
    },
    {
      "name": "3D Models & Print Files",
      "folder": "3D Models",
      "extensions": [
        ".stl",
        ".3mf",
        ".obj",
        ".3ds",
        ".fbx",
        ".blend",
        ".glb",
        ".gltf",
        ".gcode",
        ".bgcode",
        ".nc",
        ".tap",
        ".ngc",
        ".gco",
        ".g"
      ],
      "enabled": true
    },
    {
      "name": "CAD & Engineering",
      "folder": "CAD",
      "extensions": [
        ".step",
        ".stp",
        ".iges",
        ".igs",
        ".f3d",
        ".f3z",
        ".ipt",
        ".iam",
        ".sldprt",
        ".sldasm",
        ".slddrw",
        ".dwg",
        ".dxf"
      ],
      "enabled": true
    },
    {
      "name": "Images",
      "folder": "Images",
      "extensions": [
        ".jpg",
        ".jpeg",
        ".png",
        ".gif",
        ".webp",
        ".heic",
        ".svg",
        ".bmp",
        ".tif",
        ".tiff",
        ".ico",
        ".ai",
        ".eps",
        ".cdr"
      ],
      "enabled": true
    },
    {
      "name": "Videos",
      "folder": "Videos",
      "extensions": [
        ".mp4",
        ".mov",
        ".mkv",
        ".avi",
        ".webm",
        ".flv",
        ".wmv",
        ".m4v"
      ],
      "enabled": true
    },
    {
      "name": "Audio",
      "folder": "Audio",
      "extensions": [
        ".mp3",
        ".wav",
        ".flac",
        ".m4a",
        ".aac",
        ".ogg",
        ".aiff",
        ".wma"
      ],
      "enabled": true
    },
    {
      "name": "Archives",
      "folder": "Archives",
      "extensions": [
        ".zip",
        ".rar",
        ".7z",
        ".tar",
        ".gz",
        ".bz2",
        ".xz",
        ".tgz",
        ".iso"
      ],
      "enabled": true
    },
    {
      "name": "Installers",
      "folder": "Installers",
      "extensions": [
        ".exe",
        ".msi",
        ".msix"
      ],
      "enabled": true
    },
    {
      "name": "Code & Data",
      "folder": "Code",
      "extensions": [
        ".py",
        ".js",
        ".ts",
        ".jsx",
        ".tsx",
        ".html",
        ".css",
        ".cpp",
        ".c",
        ".h",
        ".hpp",
        ".cs",
        ".java",
        ".rs",
        ".go",
        ".json",
        ".yaml",
        ".yml",
        ".toml",
        ".xml",
        ".ini",
        ".env",
        ".sql",
        ".db",
        ".sqlite",
        ".parquet",
        ".feather",
        ".log",
        ".dmp",
        ".out"
      ],
      "enabled": true
    }
  ],
  "default_folder": "Other",
  "batch_handoff": {
    "enabled": true,
    "gap_seconds": 25,
    "max_span_seconds": 120,
    "max_files": 50,
    "hotkey_latest": "Ctrl+G",
    "hotkey_all": "Ctrl+Shift+G",
    "hotkey_copy": "Ctrl+Shift+C",
    "stage_copy_limit_mb": 200,
    "stage_prune_hours": 24
  },
  "hold": {
    "enabled": false,
    "extensions": [
      ".3mf"
    ],
    "hold_days": 7,
    "max_held": 15,
    "slicers": [
      "bambu-studio.exe",
      "bambu-studio-worker.exe",
      "orca-slicer.exe",
      "prusa-slicer.exe",
      "cura.exe",
      "chitubox.exe"
    ]
  },
  "mirror": {
    "enabled": false
  },
  "remodel": {
    "enabled": true,
    "quarantine_days": 30,
    "active_folder_days": 14,
    "desktop_min_age_days": 30
  },
  "makerworld_destination": "3D Models\\MakerWorld",
  "downloads_dir": "${USERPROFILE}\\Downloads",
  "learning": {
    "enabled": true,
    "suggest": true
  },
  "cleanup": {
    "enabled": false,
    "days": 30,
    "folders": [
      "Installers",
      "Archives"
    ]
  },
  "photos": {
    "by_month": false,
    "split_by_kind": true
  },
  "pdf_text": {
    "enabled": false,
    "max_mb": 10
  },
  "desktop_sweep": {
    "enabled": false,
    "days": 7
  },
  "bambu_recent": {
    "enabled": false,
    "asked": false
  },
  "shelf": {
    "enabled": true,
    "hotkey": "Ctrl+Shift+Space"
  },
  "rename": {
    "tidy": false,
    "add_date": false
  },
  "update_check": {
    "enabled": true
  },
  "type_folders": {
    "enabled": true,
    "names": {}
  },
  "my_folders": {
    "enabled": true,
    "skip": []
  },
  "makerworld_by_designer": false,
  "makerworld_kits": true
}
